        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $('Webhook').item.json.body.user_id, text: 'Готово: задача выполнена (замените этот текст результатом)' }) }}",
        "options": {}
      },
      "id": "cb",
      "name": "Callback в бота",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
