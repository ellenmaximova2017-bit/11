{
  "name": "Bot: ping (проверка связи)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bot-ping",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "bot-ping",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bot secret"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=pong. user_id={{ $json.body.user_id }}, text={{ $json.body.payload.text }}",
        "options": {}
      },
      "id": "resp",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        260,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}