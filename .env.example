TELEGRAM_BOT_TOKEN=        # от @BotFather
ANTHROPIC_API_KEY=         # console.anthropic.com
CLAUDE_MODEL=claude-sonnet-5-5
PAYMENT_PROVIDER_TOKEN=    # токен ЮKassa/др. из @BotFather -> Payments (пусто = оплата выключена)
FREE_MESSAGES=3            # бесплатных запросов до paywall
PRICE_MONTH_RUB=1490
PRICE_WEEK_RUB=790
ADMIN_ID=                  # ваш Telegram id для /stats
WEBAPP_URL=                # публичный https-адрес, где крутится бот (Mini App), напр. https://bot.example.com
WEB_PORT=8080
DISCOUNT_PERCENT=30        # скидка новому пользователю
DISCOUNT_HOURS=24          # сколько часов после /start она действует (таймер в Mini App настоящий)
