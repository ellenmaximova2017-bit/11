TELEGRAM_BOT_TOKEN=        # от @BotFather
ANTHROPIC_API_KEY=         # console.anthropic.com
CLAUDE_MODEL=claude-sonnet-5-5
PAYMENT_PROVIDER_TOKEN=    # токен ЮKassa/др. из @BotFather -> Payments (пусто = оплата выключена)
FREE_MESSAGES=3            # бесплатных запросов до paywall
PRICE_MONTH_RUB=1490
PRICE_WEEK_RUB=790
ADMIN_ID=                  # ваш Telegram id для /stats
WEBAPP_URL=                # публичный https-адрес, где крутится бот (Mini App), напр. https://bot.example.com
WEB_PORT=8080
DISCOUNT_PERCENT=30        # скидка новому пользователю
DISCOUNT_HOURS=24          # сколько часов после /start она действует (таймер в Mini App настоящий)
GOOGLE_CLIENT_ID=          # Google Cloud Console -> OAuth client (Web); redirect URI: <WEBAPP_URL>/oauth/google/callback
GOOGLE_CLIENT_SECRET=
# --- расширения (все необязательны) ---
STARS_MONTH=500            # цена подписки в Telegram Stars (автопродление раз в 30 дней, отмена через /cancel); 0 = выкл
REFERRAL_BONUS=3           # бонусных запросов пригласившему и приглашённому
OPENAI_API_KEY=            # только для расшифровки голосовых (Whisper)
REPLICATE_API_TOKEN=       # редактирование фото (убрать человека, фон)
REPLICATE_EDIT_MODEL=black-forest-labs/flux-kontext-pro
APIFY_TOKEN=               # чтение публичных Instagram-профилей
# --- лимиты подписки ---
CREDITS_MONTH=150          # запросов, которые входят в подписку «Месяц» (и в каждое продление Stars)
CREDITS_WEEK=40            # запросов в подписке «Неделя»
TOPUP_CREDITS=50           # размер пакета докупки (только при активной подписке)
TOPUP_RUB=290              # цена пакета в рублях (0 = выкл)
TOPUP_STARS=200            # цена пакета в Stars (0 = выкл)
DGIS_API_KEY=             # ключ 2ГИС Places API (platform.2gis.ru); без него поиск идёт по OpenStreetMap
YANDEX_SEARCH_KEY=         # ключ API «Поиск по организациям» (developer.tech.yandex.ru)
YANDEX_GEOCODER_KEY=       # ключ HTTP Геокодера (адрес -> координаты); без него адреса геокодируются 2ГИС/OSM
